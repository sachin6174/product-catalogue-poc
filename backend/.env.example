# Copy to .env to override defaults when running the backend with npm.
# Everything here has a sensible default, so .env is optional.

PORT=3001
FAKE_STORE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=300

# The 5 "top rated" products shown on the home page, in display order.
FEATURED_PRODUCT_IDS=11,3,18,5,19

# console = print enquiry emails to the terminal
# smtp    = send via SMTP (Mailpit locally: docker compose up mailpit, then open http://localhost:8025)
EMAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Catalogue <no-reply@catalogue.local>
SALES_INBOX=sales@catalogue.local
